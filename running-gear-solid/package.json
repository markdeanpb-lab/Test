{
  "name": "running-gear-solid",
  "private": true,
  "version": "1.0.0",
  "description": "RUNNING GEAR SOLID - a real Strava running career reimagined as a lost 1998 tactical espionage game. Deterministic Three.js film.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "audio": "tsx scripts/synth-audio.ts",
    "render": "npm run audio && node scripts/render.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.55.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}

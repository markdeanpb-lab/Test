--- /dev/null
+++ b/app/src/main/java/com/winlator/widget/DirectTouchView.java
@@ -0,0 +1,327 @@
+package com.winlator.widget;
+
+import android.content.Context;
+import android.view.HapticFeedbackConstants;
+import android.view.InputDevice;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+
+import com.winlator.renderer.GLRenderer;
+import com.winlator.renderer.ViewTransformation;
+import com.winlator.xserver.Pointer;
+import com.winlator.xserver.XServer;
+
+/**
+ * Touchscreen-as-mouse layer used for EWR: the cursor goes exactly where the finger is.
+ *
+ * One finger: tap = left click, drag = left-button drag, hold = right click.
+ * Two fingers: drag = mouse wheel (or pan when zoomed), pinch = zoom, tap = right click.
+ * Three-finger tap: toggle the on-screen keyboard. Four-finger tap: open the menu.
+ */
+public class DirectTouchView extends View {
+    private static final int LONG_PRESS_MS = 550;
+    private static final int TAP_MS = 300;
+    private static final int DOUBLE_TAP_MS = 450;
+    private static final byte MODE_IDLE = 0;
+    private static final byte MODE_PENDING = 1;
+    private static final byte MODE_DRAG = 2;
+    private static final byte MODE_MULTI = 3;
+    private static final byte MODE_DONE = 4;
+
+    private final XServer xServer;
+    private final TouchpadView touchpadView;
+    private final float slop;
+    private final float scrollStep;
+    private byte mode = MODE_IDLE;
+    private int maxFingers = 0;
+    private long downTime;
+    private float startX, startY;
+    private float lastX, lastY;
+    private boolean rightClickNext = false;
+    private long lastTapTime = 0;
+    private float lastTapViewX, lastTapViewY;
+    private int lastTapSceneX, lastTapSceneY;
+
+    private float pinchStartDist;
+    private float pinchStartMidX, pinchStartMidY;
+    private float pinchStartZoom, pinchStartPanX, pinchStartPanY;
+    private boolean pinching = false;
+    private boolean multiMoved = false;
+    private float scrollAccum = 0;
+    private float lastMidY;
+
+    private Runnable keyboardCallback;
+    private Runnable menuCallback;
+    private Runnable rightClickModeChangedCallback;
+
+    private final Runnable longPressRunnable = () -> {
+        if (mode == MODE_PENDING && maxFingers == 1) {
+            performHapticFeedback(HapticFeedbackConstants.LONG_PRESS);
+            int[] p = toScene(startX, startY);
+            click(Pointer.Button.BUTTON_RIGHT, p[0], p[1]);
+            mode = MODE_DONE;
+        }
+    };
+
+    public DirectTouchView(Context context, XServer xServer, TouchpadView touchpadView) {
+        super(context);
+        this.xServer = xServer;
+        this.touchpadView = touchpadView;
+        float density = context.getResources().getDisplayMetrics().density;
+        slop = 10 * density;
+        scrollStep = 28 * density;
+        setLayoutParams(new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        setClickable(true);
+    }
+
+    public void setKeyboardCallback(Runnable keyboardCallback) {
+        this.keyboardCallback = keyboardCallback;
+    }
+
+    public void setMenuCallback(Runnable menuCallback) {
+        this.menuCallback = menuCallback;
+    }
+
+    public void setRightClickModeChangedCallback(Runnable callback) {
+        this.rightClickModeChangedCallback = callback;
+    }
+
+    public boolean isRightClickNext() {
+        return rightClickNext;
+    }
+
+    public void setRightClickNext(boolean rightClickNext) {
+        this.rightClickNext = rightClickNext;
+        if (rightClickModeChangedCallback != null) rightClickModeChangedCallback.run();
+    }
+
+    private GLRenderer renderer() {
+        return xServer.getRenderer();
+    }
+
+    /** Unzoomed X-screen coordinates of a point on this view. */
+    private float[] toScreenUnzoomed(float x, float y) {
+        GLRenderer renderer = renderer();
+        int w = xServer.screenInfo.width, h = xServer.screenInfo.height;
+        if (renderer.isFullscreen()) return new float[]{x * w / getWidth(), y * h / getHeight()};
+        ViewTransformation vt = new ViewTransformation();
+        vt.update(getWidth(), getHeight(), w, h);
+        return new float[]{(x - vt.viewOffsetX) / vt.aspect, (y - vt.viewOffsetY) / vt.aspect};
+    }
+
+    private int[] toScene(float x, float y) {
+        GLRenderer renderer = renderer();
+        float[] p = toScreenUnzoomed(x, y);
+        float sx, sy;
+        if (renderer.isScreenOffsetYRelativeToCursor()) {
+            // While the soft keyboard is open the renderer shifts the screen up to keep the cursor visible (see GLRenderer.drawFrame).
+            int h = xServer.screenInfo.height;
+            float offsetY = Math.max(0, Math.min(h * 0.5f, xServer.pointer.getY() - h * 0.25f));
+            sx = p[0];
+            sy = p[1] + offsetY;
+        }
+        else {
+            float zoom = renderer.getViewZoom();
+            sx = renderer.getViewPanX() + p[0] / zoom;
+            sy = renderer.getViewPanY() + p[1] / zoom;
+        }
+        int maxX = xServer.screenInfo.width - 1, maxY = xServer.screenInfo.height - 1;
+        return new int[]{(int)Math.max(0, Math.min(maxX, sx)), (int)Math.max(0, Math.min(maxY, sy))};
+    }
+
+    private void moveTo(int x, int y) {
+        xServer.injectPointerMove(x, y);
+    }
+
+    private void click(Pointer.Button button, int x, int y) {
+        moveTo(x, y);
+        if (xServer.pointer.isButtonPressed(button)) xServer.injectPointerButtonRelease(button);
+        xServer.injectPointerButtonPress(button);
+        postDelayed(() -> xServer.injectPointerButtonRelease(button), 40);
+    }
+
+    private void releaseLeftIfPressed() {
+        if (xServer.pointer.isButtonPressed(Pointer.Button.BUTTON_LEFT)) xServer.injectPointerButtonRelease(Pointer.Button.BUTTON_LEFT);
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        if (event.isFromSource(InputDevice.SOURCE_MOUSE)) return touchpadView.onTouchEvent(event);
+
+        int action = event.getActionMasked();
+        int count = event.getPointerCount();
+
+        switch (action) {
+            case MotionEvent.ACTION_DOWN:
+                mode = MODE_PENDING;
+                maxFingers = 1;
+                downTime = System.currentTimeMillis();
+                startX = lastX = event.getX();
+                startY = lastY = event.getY();
+                int[] p = toScene(startX, startY);
+                moveTo(p[0], p[1]);
+                if (!rightClickNext) postDelayed(longPressRunnable, LONG_PRESS_MS);
+                break;
+            case MotionEvent.ACTION_POINTER_DOWN:
+                removeCallbacks(longPressRunnable);
+                maxFingers = Math.max(maxFingers, count);
+                if (mode == MODE_DRAG) releaseLeftIfPressed();
+                if (mode == MODE_PENDING || mode == MODE_DRAG || mode == MODE_MULTI) {
+                    if (count == 2) startMulti(event);
+                    mode = MODE_MULTI;
+                }
+                break;
+            case MotionEvent.ACTION_MOVE:
+                if (mode == MODE_PENDING && count == 1) {
+                    if (Math.hypot(event.getX() - startX, event.getY() - startY) > slop) {
+                        removeCallbacks(longPressRunnable);
+                        if (rightClickNext) {
+                            mode = MODE_DONE;
+                        }
+                        else {
+                            int[] s = toScene(startX, startY);
+                            moveTo(s[0], s[1]);
+                            xServer.injectPointerButtonPress(Pointer.Button.BUTTON_LEFT);
+                            mode = MODE_DRAG;
+                        }
+                    }
+                }
+                if (mode == MODE_DRAG) {
+                    int[] s = toScene(event.getX(), event.getY());
+                    moveTo(s[0], s[1]);
+                }
+                else if (mode == MODE_MULTI && count == 2 && maxFingers == 2) {
+                    handleMultiMove(event);
+                }
+                lastX = event.getX();
+                lastY = event.getY();
+                break;
+            case MotionEvent.ACTION_POINTER_UP:
+                if (mode == MODE_MULTI) {
+                    long duration = System.currentTimeMillis() - downTime;
+                    if (duration < TAP_MS && !pinching && !multiMoved) {
+                        if (maxFingers == 2) {
+                            int[] s = toScene(startX, startY);
+                            click(Pointer.Button.BUTTON_RIGHT, s[0], s[1]);
+                        }
+                        else if (maxFingers == 3 && keyboardCallback != null) keyboardCallback.run();
+                        else if (maxFingers == 4 && menuCallback != null) menuCallback.run();
+                    }
+                    mode = MODE_DONE;
+                }
+                break;
+            case MotionEvent.ACTION_UP:
+                removeCallbacks(longPressRunnable);
+                if (mode == MODE_PENDING) {
+                    handleTap(event.getX(), event.getY());
+                }
+                else if (mode == MODE_DRAG) {
+                    int[] s = toScene(event.getX(), event.getY());
+                    moveTo(s[0], s[1]);
+                    releaseLeftIfPressed();
+                }
+                mode = MODE_IDLE;
+                pinching = false;
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                removeCallbacks(longPressRunnable);
+                if (mode == MODE_DRAG) releaseLeftIfPressed();
+                mode = MODE_IDLE;
+                pinching = false;
+                break;
+        }
+        return true;
+    }
+
+    private void handleTap(float x, float y) {
+        long now = System.currentTimeMillis();
+        int[] s;
+        // Fingers wobble by more than Windows' double-click rectangle, so a quick second tap near the first one reuses its exact position.
+        if (now - lastTapTime < DOUBLE_TAP_MS && Math.hypot(x - lastTapViewX, y - lastTapViewY) < slop * 3) {
+            s = new int[]{lastTapSceneX, lastTapSceneY};
+        }
+        else s = toScene(x, y);
+
+        if (rightClickNext) {
+            click(Pointer.Button.BUTTON_RIGHT, s[0], s[1]);
+            setRightClickNext(false);
+            lastTapTime = 0;
+            return;
+        }
+
+        click(Pointer.Button.BUTTON_LEFT, s[0], s[1]);
+        lastTapTime = now;
+        lastTapViewX = x;
+        lastTapViewY = y;
+        lastTapSceneX = s[0];
+        lastTapSceneY = s[1];
+    }
+
+    private void startMulti(MotionEvent event) {
+        GLRenderer renderer = renderer();
+        pinchStartDist = distance(event);
+        pinchStartMidX = (event.getX(0) + event.getX(1)) * 0.5f;
+        pinchStartMidY = lastMidY = (event.getY(0) + event.getY(1)) * 0.5f;
+        pinchStartZoom = renderer.getViewZoom();
+        pinchStartPanX = renderer.getViewPanX();
+        pinchStartPanY = renderer.getViewPanY();
+        pinching = false;
+        multiMoved = false;
+        scrollAccum = 0;
+    }
+
+    private static float distance(MotionEvent event) {
+        return (float)Math.hypot(event.getX(0) - event.getX(1), event.getY(0) - event.getY(1));
+    }
+
+    private void handleMultiMove(MotionEvent event) {
+        GLRenderer renderer = renderer();
+        float dist = distance(event);
+        float midX = (event.getX(0) + event.getX(1)) * 0.5f;
+        float midY = (event.getY(0) + event.getY(1)) * 0.5f;
+
+        if (!pinching && pinchStartDist > 0 && Math.abs(dist - pinchStartDist) > slop * 3) pinching = true;
+        if (!multiMoved && Math.hypot(midX - pinchStartMidX, midY - pinchStartMidY) > slop) multiMoved = true;
+
+        if (pinching) {
+            float zoom = pinchStartZoom * (dist / pinchStartDist);
+            float[] startMid = toScreenUnzoomed(pinchStartMidX, pinchStartMidY);
+            float anchorX = pinchStartPanX + startMid[0] / pinchStartZoom;
+            float anchorY = pinchStartPanY + startMid[1] / pinchStartZoom;
+            float[] mid = toScreenUnzoomed(midX, midY);
+            float clampedZoom = Math.max(1.0f, Math.min(4.0f, zoom));
+            renderer.setViewZoom(clampedZoom, anchorX - mid[0] / clampedZoom, anchorY - mid[1] / clampedZoom);
+        }
+        else if (multiMoved) {
+            if (renderer.getViewZoom() > 1.0f) {
+                float[] startMid = toScreenUnzoomed(pinchStartMidX, pinchStartMidY);
+                float[] mid = toScreenUnzoomed(midX, midY);
+                float zoom = renderer.getViewZoom();
+                renderer.setViewZoom(zoom, pinchStartPanX - (mid[0] - startMid[0]) / zoom, pinchStartPanY - (mid[1] - startMid[1]) / zoom);
+            }
+            else {
+                scrollAccum += midY - lastMidY;
+                while (scrollAccum <= -scrollStep) {
+                    wheel(Pointer.Button.BUTTON_SCROLL_DOWN);
+                    scrollAccum += scrollStep;
+                }
+                while (scrollAccum >= scrollStep) {
+                    wheel(Pointer.Button.BUTTON_SCROLL_UP);
+                    scrollAccum -= scrollStep;
+                }
+            }
+        }
+        lastMidY = midY;
+    }
+
+    private void wheel(Pointer.Button button) {
+        xServer.injectPointerButtonPress(button);
+        xServer.injectPointerButtonRelease(button);
+    }
+
+    public void resetZoom() {
+        renderer().setViewZoom(1.0f, 0, 0);
+    }
+}

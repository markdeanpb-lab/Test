+import java.util.zip.ZipOutputStream;
+
+/**
+ * Entry point of the EWR build: prepares the Wine environment once, keeps the original
+ * Extreme Warfare Revenge files inside the container's C: drive and launches EWRevenge.exe.
+ */
+public class EWRLauncherActivity extends AppCompatActivity {
+    public static final String EXTRA_EWR_MODE = "ewr_mode";
+    private static final String GAME_ASSET = "ewr/game.zip";
+    private static final String VB6_RUNTIME_ASSET = "ewr/msvbvm60.dll";
+    private static final String EXE_NAME = "EWRevenge.exe";
+    private static final int REQUEST_BACKUP = 101;
+    private static final int REQUEST_RESTORE = 102;
+    private static final int REQUEST_IMPORT_DATABASE = 103;
+    private static final int MAX_AUTO_BACKUPS = 5;
+    private static final List<String> GAME_FOLDERS = Arrays.asList("DATA", "GFX", "GUIDE", "PICS", "LOGOS", "BANNERS", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8");
+    private static final List<String> DATABASE_FOLDERS = Arrays.asList("DATA", "PICS", "LOGOS", "BANNERS");
+
+    private Container container;
+    private TextView statusText;
+    private final ArrayList<Button> actionButtons = new ArrayList<>();
+    private PreloaderDialog preloaderDialog;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        AppUtils.setActivityTheme(this);
+        super.onCreate(savedInstanceState);
+        preloaderDialog = new PreloaderDialog(this);
+        applyDefaultPreferences();
+        setContentView(createContentView());
+        setButtonsEnabled(false);
+
+        if (RootFSInstaller.isInstallNeeded(this)) {
+            statusText.setText(R.string.ewr_status_installing);
+            RootFSInstaller.install(this, this::prepareGame);
+        }
+        else prepareGame();
+    }
+
+    private void applyDefaultPreferences() {
+        SharedPreferences preferences = PreferenceManager.getDefaultSharedPreferences(this);
+        if (!preferences.getBoolean("ewr_defaults_applied", false)) {
+            preferences.edit()
+                .putBoolean("ewr_defaults_applied", true)
+                .putBoolean("open_android_browser_from_wine", true)
+                .putFloat("cursor_scale", 1.0f)
+                .apply();
+        }
+    }
+
+    private View createContentView() {
+        float density = getResources().getDisplayMetrics().density;
+        int pad = (int)(16 * density);
+
+        LinearLayout column = new LinearLayout(this);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setPadding(pad, pad, pad, pad);
+        column.setGravity(Gravity.CENTER_HORIZONTAL);
+
+        TextView title = new TextView(this);
+        title.setText(R.string.ewr_title);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 24);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        title.setTextColor(Color.WHITE);
+        title.setGravity(Gravity.CENTER);
+        column.addView(title);
+
+        statusText = new TextView(this);
+        statusText.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        statusText.setTextColor(0xffcccccc);
+        statusText.setGravity(Gravity.CENTER);
+        statusText.setPadding(0, pad / 2, 0, pad);
+        column.addView(statusText);
+
+        addButton(column, R.string.ewr_play, this::play).setTextSize(TypedValue.COMPLEX_UNIT_SP, 20);
+        addButton(column, R.string.ewr_backup, this::requestBackup);
+        addButton(column, R.string.ewr_restore, () -> pickZip(REQUEST_RESTORE));
+        addButton(column, R.string.ewr_import_database, () -> pickZip(REQUEST_IMPORT_DATABASE));
+        addButton(column, R.string.ewr_reset_database, this::confirmResetDatabase);
+        addButton(column, R.string.ewr_controls_help, this::showControlsHelp);
+        addButton(column, R.string.ewr_advanced, () -> startActivity(new Intent(this, MainActivity.class)));
+
+        ScrollView scrollView = new ScrollView(this);
+        scrollView.setBackgroundColor(0xff10105a);
+        scrollView.setFillViewport(true);
+        scrollView.addView(column);
+        return scrollView;
+    }
+
+    private Button addButton(LinearLayout parent, int textResId, Runnable action) {
+        float density = getResources().getDisplayMetrics().density;
+        Button button = new Button(this);
+        button.setText(textResId);
+        button.setAllCaps(false);
+        button.setOnClickListener((v) -> action.run());
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams((int)(320 * density), LinearLayout.LayoutParams.WRAP_CONTENT);
+        params.setMargins(0, (int)(4 * density), 0, (int)(4 * density));
+        button.setLayoutParams(params);
+        parent.addView(button);
+        actionButtons.add(button);
+        return button;
+    }
+
+    private void setButtonsEnabled(boolean enabled) {
+        for (Button button : actionButtons) button.setEnabled(enabled);
+    }
+
+    private File getGameDir() {
+        return new File(container.getRootDir(), ".wine/drive_c/EWR");
+    }
+
+    private File getAutoBackupDir() {
+        File dir = new File(getFilesDir(), "ewr_backups");
+        dir.mkdirs();
+        return dir;
+    }
+
+    private void prepareGame() {
+        statusText.setText(R.string.ewr_status_preparing);
+        ContainerManager manager = new ContainerManager(this);
+        for (Container candidate : manager.getContainers()) {
+            if (candidate.getExtra("ewr").equals("1")) container = candidate;
+        }
+
+        if (container != null) {
+            installGameFilesAsync();
+            return;
+        }
+
+        try {
+            JSONObject data = new JSONObject();
+            data.put("name", "EWR");
+            // EWR's screens are designed for an 800x600 desktop; the renderer scales this to the phone without changing proportions.
+            data.put("screenSize", "800x600");
+            // The game was written for an English (period-as-decimal) Windows; pin the locale so data files parse identically.
+            data.put("envVars", Container.DEFAULT_ENV_VARS+" LC_ALL=en_US.UTF-8");
+            data.put("drives", "");
+            preloaderDialog.show(R.string.ewr_status_preparing);
+            manager.createContainerAsync(data, (created) -> {
+                preloaderDialog.close();
+                if (created == null) {
+                    statusText.setText(R.string.ewr_status_failed);
+                    return;
+                }
+                created.putExtra("ewr", "1");
+                created.saveData();
+                container = created;
+                installGameFilesAsync();
+            });
+        }
+        catch (JSONException e) {
+            statusText.setText(R.string.ewr_status_failed);
+        }
+    }
+
+    private void installGameFilesAsync() {
+        preloaderDialog.show(R.string.ewr_status_preparing);
+        Executors.newSingleThreadExecutor().execute(() -> {
+            boolean success = installGameFiles();
+            runOnUiThread(() -> {
+                preloaderDialog.close();
+                if (success) {
+                    setButtonsEnabled(true);
+                    updateStatus();
+                }
+                else statusText.setText(R.string.ewr_status_failed);
+            });
+        });
+    }
+
+    /** Copies the original game on first run only; existing saves and databases are never overwritten here. */
+    private boolean installGameFiles() {
+        File gameDir = getGameDir();
+        if (!new File(gameDir, EXE_NAME).isFile()) {
+            gameDir.mkdirs();
+            try (InputStream inStream = getAssets().open(GAME_ASSET)) {
+                if (!extractZip(inStream, gameDir, null)) return false;
+            }
+            catch (IOException e) {
+                return false;
+            }
+        }
+        for (String folder : GAME_FOLDERS) new File(gameDir, folder).mkdirs();
+        return installVB6Runtime() && new File(gameDir, EXE_NAME).isFile();
+    }
+
+    private boolean installVB6Runtime() {
+        File dstFile = new File(container.getRootDir(), ".wine/drive_c/windows/syswow64/msvbvm60.dll");
+        if (dstFile.isFile() && dstFile.length() > 0) return true;
+        FileUtils.copy(this, VB6_RUNTIME_ASSET, dstFile);
+        return dstFile.isFile();
+    }
+
+    private void updateStatus() {
+        int slots = 0;
+        File gameDir = getGameDir();
+        for (int i = 1; i <= 8; i++) {
+            if (new File(gameDir, "s"+i+"/gameinfo.dat").isFile()) slots++;
+        }
+        statusText.setText(getString(R.string.ewr_status_ready, slots));
+    }
+
+    private void play() {
+        if (!installVB6Runtime()) {
+            AppUtils.showToast(this, R.string.ewr_status_failed);
+            return;
+        }
+        Intent intent = new Intent(this, XServerDisplayActivity.class);
+        intent.putExtra("container_id", container.id);
+        intent.putExtra("exec_path", new File(getGameDir(), EXE_NAME).getPath());
+        intent.putExtra(EXTRA_EWR_MODE, true);
+        startActivity(intent);
+        finish();
+    }
+
+    private static String timestamp() {
+        return new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date());
+    }
+
+    private void requestBackup() {
+        Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("application/zip");
+        intent.putExtra(Intent.EXTRA_TITLE, "EWR-backup-"+timestamp()+".zip");
+        startActivityForResult(intent, REQUEST_BACKUP);
+    }
+
+    private void pickZip(int requestCode) {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("*/*");
+        intent.putExtra(Intent.EXTRA_MIME_TYPES, new String[]{"application/zip", "application/x-zip-compressed", "application/octet-stream"});
+        startActivityForResult(intent, requestCode);
+    }
+
+    private void confirmResetDatabase() {
+        new AlertDialog.Builder(this)
+            .setTitle(R.string.ewr_reset_database)
+            .setMessage(R.string.ewr_reset_database_message)
+            .setPositiveButton(android.R.string.ok, (d, w) -> runTask(() -> {
+                createAutoBackup();
+                try (InputStream inStream = getAssets().open(GAME_ASSET)) {
+                    return extractZip(inStream, getGameDir(), Arrays.asList("DATA"));
+                }
+            }, R.string.ewr_reset_database_done))
+            .setNegativeButton(android.R.string.cancel, null)
+            .show();
+    }
+
+    private void showControlsHelp() {
+        new AlertDialog.Builder(this)
+            .setTitle(R.string.ewr_controls_help)
+            .setMessage(R.string.ewr_controls_help_message)
+            .setPositiveButton(android.R.string.ok, null)
+            .show();
+    }
+
+    private interface Task {
+        boolean run() throws Exception;
+    }
+
+    private void runTask(Task task, int successResId) {
+        setButtonsEnabled(false);
+        preloaderDialog.show(R.string.ewr_working);
+        Executors.newSingleThreadExecutor().execute(() -> {
+            boolean success;
+            try {
+                success = task.run();
+            }
+            catch (Exception e) {
+                success = false;
+            }
+            final boolean result = success;
+            runOnUiThread(() -> {
+                preloaderDialog.close();
+                setButtonsEnabled(true);
+                updateStatus();
+                new AlertDialog.Builder(this)
+                    .setMessage(result ? successResId : R.string.ewr_operation_failed)
+                    .setPositiveButton(android.R.string.ok, null)
+                    .show();
+            });
+        });
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, @Nullable Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (resultCode != Activity.RESULT_OK || data == null || data.getData() == null || container == null) return;
+        final Uri uri = data.getData();
+
+        switch (requestCode) {
+            case REQUEST_BACKUP:
+                runTask(() -> {
+                    try (OutputStream outStream = getContentResolver().openOutputStream(uri)) {
+                        return outStream != null && zipGameDir(outStream);
+                    }
+                }, R.string.ewr_backup_done);
+                break;
+            case REQUEST_RESTORE:
+                runTask(() -> importZip(uri, GAME_FOLDERS, true), R.string.ewr_restore_done);
+                break;
+            case REQUEST_IMPORT_DATABASE:
+                runTask(() -> importZip(uri, DATABASE_FOLDERS, false), R.string.ewr_import_database_done);
+                break;
+        }
+    }
+
+    private boolean zipGameDir(OutputStream outStream) throws IOException {
+        try (ZipOutputStream zip = new ZipOutputStream(new BufferedOutputStream(outStream, StreamUtils.BUFFER_SIZE))) {
+            addToZip(zip, getGameDir(), "EWR/");
+        }
+        return true;
+    }
+
+    private void addToZip(ZipOutputStream zip, File dir, String basePath) throws IOException {
+        File[] files = dir.listFiles();
+        if (files == null) return;
+        zip.putNextEntry(new ZipEntry(basePath));
+        zip.closeEntry();
+        for (File file : files) {
+            if (FileUtils.isSymlink(file)) continue;
+            if (file.isDirectory()) {
+                addToZip(zip, file, basePath+file.getName()+"/");
+            }
+            else {
+                ZipEntry entry = new ZipEntry(basePath+file.getName());
+                entry.setTime(file.lastModified());
+                zip.putNextEntry(entry);
+                try (InputStream inStream = new BufferedInputStream(new FileInputStream(file), StreamUtils.BUFFER_SIZE)) {
+                    StreamUtils.copy(inStream, zip);
+                }
+                zip.closeEntry();
+            }
+        }
+    }
+
+    /** Keeps a private copy of the whole game folder before anything is overwritten. */
+    private void createAutoBackup() throws IOException {
+        File dir = getAutoBackupDir();
+        File file = new File(dir, "auto-"+timestamp()+".zip");
+        try (OutputStream outStream = new FileOutputStream(file)) {
+            zipGameDir(outStream);
+        }
+
+        File[] backups = dir.listFiles((d, name) -> name.startsWith("auto-") && name.endsWith(".zip"));
+        if (backups != null && backups.length > MAX_AUTO_BACKUPS) {
+            Arrays.sort(backups, (a, b) -> a.getName().compareTo(b.getName()));
+            for (int i = 0; i < backups.length - MAX_AUTO_BACKUPS; i++) FileUtils.delete(backups[i]);
+        }
+    }
+
+    /**
+     * Imports a zip made from a PC or phone EWR folder. The game folder may sit at any depth
+     * (e.g. "EWR/s1/..." or "s1/..."); only the listed top-level folders are written.
+     * For databases, a zip that just contains the .dat files is also accepted.
+     */
+    private boolean importZip(Uri uri, List<String> allowedFolders, boolean allowExe) throws Exception {
+        File tempFile = new File(getCacheDir(), "ewr-import.zip");
+        try (InputStream inStream = getContentResolver().openInputStream(uri);
+             OutputStream outStream = new FileOutputStream(tempFile)) {
+            if (inStream == null) return false;
+            StreamUtils.copy(inStream, outStream);
+        }
+
+        try (ZipFile zipFile = new ZipFile(tempFile)) {
+            String prefix = null;
+            String looseDataPrefix = null;
+            Enumeration<? extends ZipEntry> entries = zipFile.entries();
+            while (entries.hasMoreElements() && prefix == null) {
+                String name = entries.nextElement().getName().replace('\\', '/');
+                String[] parts = name.split("/");
+                for (int i = 0; i < parts.length; i++) {
+                    boolean isFolder = i < parts.length - 1 && canonicalFolder(parts[i], allowedFolders) != null;
+                    boolean isExe = allowExe && i == parts.length - 1 && parts[i].equalsIgnoreCase(EXE_NAME);
+                    if (isFolder || isExe) {
+                        prefix = joinPrefix(parts, i);
+                        break;
+                    }
+                }
+                if (looseDataPrefix == null && parts[parts.length - 1].equalsIgnoreCase("wrestler.dat")) {
+                    looseDataPrefix = joinPrefix(parts, parts.length - 1);
+                }
+            }
+
+            String targetPrefix = "";
+            if (prefix == null) {
+                if (allowedFolders.contains("DATA") && looseDataPrefix != null) {
+                    prefix = looseDataPrefix;
+                    targetPrefix = "DATA/";
+                }
+                else return false;
+            }
+
+            createAutoBackup();
+            File gameDir = getGameDir();
+            int written = 0;
+            entries = zipFile.entries();
+            while (entries.hasMoreElements()) {
+                ZipEntry entry = entries.nextElement();
+                String name = entry.getName().replace('\\', '/');
+                if (entry.isDirectory() || !name.startsWith(prefix)) continue;
+                String relative = targetPrefix + name.substring(prefix.length());
+                String[] parts = relative.split("/");
+
+                if (parts.length == 1) {
+                    if (!(allowExe && parts[0].equalsIgnoreCase(EXE_NAME))) continue;
+                }
+                else {
+                    String folder = canonicalFolder(parts[0], allowedFolders);
+                    if (folder == null) continue;
+                    if (!targetPrefix.isEmpty() && (parts.length != 2 || !parts[1].toLowerCase(Locale.ENGLISH).endsWith(".dat"))) continue;
+                    parts[0] = folder;
+                }
+
+                File dstFile = resolvePath(gameDir, parts);
+                if (dstFile == null) continue;
+                try (InputStream inStream = zipFile.getInputStream(entry);
+                     OutputStream outStream = new BufferedOutputStream(new FileOutputStream(dstFile), StreamUtils.BUFFER_SIZE)) {
+                    StreamUtils.copy(inStream, outStream);
+                }
+                if (entry.getTime() > 0) dstFile.setLastModified(entry.getTime());
+                written++;
+            }
+            return written > 0;
+        }
+        finally {
+            FileUtils.delete(tempFile);
+        }
+    }
+
+    private static String joinPrefix(String[] parts, int count) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < count; i++) sb.append(parts[i]).append('/');
+        return sb.toString();
+    }
+
+    private static String canonicalFolder(String name, List<String> allowedFolders) {
+        for (String folder : allowedFolders) if (folder.equalsIgnoreCase(name)) return folder;
+        return null;
+    }
+
+    /**
+     * Maps a relative path onto the game folder, reusing existing files/folders that differ only by
+     * letter case (Windows is case-insensitive, Android is not) and refusing anything outside it.
+     */
+    private static File resolvePath(File baseDir, String[] parts) {
+        File current = baseDir;
+        for (int i = 0; i < parts.length; i++) {
+            String part = parts[i];
+            if (part.isEmpty() || part.equals(".") || part.equals("..")) return null;
+            File match = new File(current, part);
+            if (!match.exists()) {
+                String[] names = current.list();
+                if (names != null) {
+                    for (String existing : names) {
+                        if (existing.equalsIgnoreCase(part)) {
+                            match = new File(current, existing);
+                            break;
+                        }
+                    }
+                }
+            }
+            if (i < parts.length - 1) match.mkdirs();
+            current = match;
+        }
+        return current;
+    }
+
+    /** Extracts a bundled zip; when onlyFolders is set, only those top-level folders are written. */
+    private static boolean extractZip(InputStream source, File destination, List<String> onlyFolders) throws IOException {
+        boolean any = false;
+        try (ZipInputStream zip = new ZipInputStream(new BufferedInputStream(source, StreamUtils.BUFFER_SIZE))) {
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                String[] parts = entry.getName().split("/");
+                if (onlyFolders != null && (parts.length < 2 || !onlyFolders.contains(parts[0]))) continue;
+                if (entry.isDirectory()) {
+                    File dir = resolvePath(destination, parts);
+                    if (dir != null) dir.mkdirs();
+                    continue;
+                }
+                File file = resolvePath(destination, parts);
+                if (file == null) continue;
+                try (OutputStream outStream = new BufferedOutputStream(new FileOutputStream(file), StreamUtils.BUFFER_SIZE)) {
+                    StreamUtils.copy(zip, outStream);
+                }
+                if (entry.getTime() > 0) file.setLastModified(entry.getTime());
+                any = true;
+            }
+        }
+        return any;
+    }
+}
